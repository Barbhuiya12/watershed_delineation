# INCLINE Watershed Delineation System Configuration
# Copy this file to .env or /etc/incline-watershed.env

# Path to the local uncompressed GRIT HFX v0.3.0 hydrofabric dataset directory,
# or an S3/HTTP remote URL (e.g. https://basin-delineations-public.upstream.tech/grit/hfx-v0.3.0/)
INCLINE_DATASET_PATH=/opt/datasets/grit-hfx-v0.3.0

# HTTP Server Port
PORT=8787

# HTTP Server Host (use 127.0.0.1 for reverse-proxy setup, or 0.0.0.0 for direct public access)
HOST=0.0.0.0

# Rust diagnostics
RUST_BACKTRACE=1
